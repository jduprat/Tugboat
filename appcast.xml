<?xml version="1.0" encoding="utf-8"?>
<!--
  The Sparkle feed Tugboat checks for updates, served from
  https://raw.githubusercontent.com/jduprat/Tugboat/main/appcast.xml

  It is empty until the first release: a feed with no items means "no update
  available", where a missing file means "an error occurred in retrieving update
  information". The release workflow regenerates this file on every v* tag and
  commits it back to main, so do not edit the items by hand.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
    <channel>
        <title>Tugboat</title>
        <link>https://raw.githubusercontent.com/jduprat/Tugboat/main/appcast.xml</link>
        <description>Most recent Tugboat releases</description>
        <language>en</language>
    </channel>
</rss>
